+#[tokio::test]
+async fn configured_context_registers_the_same_search_service_used_by_uploads() {
+    let files = tempfile::tempdir().unwrap();
+    let mut tools = ToolRuntimeConfig::default();
+    tools.file_search.files_storage_dir = Some(files.path().to_owned());
+    let config = Config {
+        llm_api_base: "http://127.0.0.1:1".to_owned(),
+        openai_api_key: None,
+        llm_ready_timeout_s: 1.0,
+        llm_ready_interval_s: 0.1,
+        skip_llm_ready_check: true,
+        db_url: Some("sqlite::memory:".to_owned()),
+        postgres: PostgresConfig::default(),
+        sqlite: SqliteConfig::default(),
+        tools,
+        responses: ResponsesConfig::default(),
+    };
+    let ctx = ExecutionContext::from_config(&config).await.unwrap();
+    let service = ctx.file_search.as_ref().unwrap();
+    let file = service
+        .upload_file(
+            "policy.txt",
+            "text/plain",
+            "assistants",
+            b"The policy protects coral reefs.".to_vec(),
+        )
+        .await
+        .unwrap();
+    let store = service
+        .create_vector_store(CreateVectorStoreRequest::default())
+        .await
+        .unwrap();
+    service
+        .attach_file(
+            &store.id,
+            AttachFileRequest {
+                file_id: file.id,
+                ..Default::default()
+            },
+        )
+        .await
+        .unwrap();
+    let params = FileSearchExecutionParams {
+        declaration: serde_json::from_value(json!({"vector_store_ids":[store.id]})).unwrap(),
+        include_results: true,
+    };
+    let output = ctx
+        .gateway_executors
+        .file_search_handler()
+        .execute("call_startup", "file_search", r#"{"queries":["coral"]}"#, &params)
+        .await
+        .unwrap();
+    assert!(output.output.contains("coral reefs"));
+}
